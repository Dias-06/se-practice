@startuml
actor Student
participant BookingService
participant BookingRepository

Student -> BookingService : requestBooking(roomId, startTime, duration)
BookingService -> BookingRepository : checkRoomBlocked(roomId)
BookingRepository --> BookingService : isBlocked status (R3)

BookingService -> BookingRepository : checkOverlap(roomId, startTime, duration)
BookingRepository --> BookingService : overlap status (R2)

alt room available and duration valid (R1, R2, R3)
  BookingService -> BookingRepository : saveBooking(bookingDetails)
  BookingRepository --> BookingService : bookingConfirmed
  BookingService --> Student : confirmBooking(confirmationDetails)
else room unavailable or invalid duration
  BookingService --> Student : rejectBooking("Room unavailable or invalid time")
end
@enduml